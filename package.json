{
  "name": "candleviewer",
  "private": true,
  "description": "CandleViewer monorepo root — pnpm workspace + Turborepo task graph.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.14.0 <21"
  },
  "packageManager": "pnpm@12.5.1+sha512.4/MFvHhKK8ifWtO2E4iJRw+ujSr182thIW7JHCw9ZAiXdfneOKrDMQROpA8kXLDVZmOS399lgk4ZB+9qLGLeXw==",
  "scripts": {
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "build": "turbo run build",
    "size": "turbo run size",
    "generate": "turbo run generate",
    "verify": "turbo run verify",
    "check:agents-commands": "node scripts/check-agents-commands.mjs",
    "check:branch-name": "node scripts/check-branch-name.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,md,css}": [
      "prettier --write"
    ],
    "services/api/**/*.py": [
      "uv run --project services/api ruff check --fix --force-exclude",
      "uv run --project services/api black --force-exclude '(candleviewer/(api|ws)/_generated/.*)'"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/lint": "^19.6.0",
    "@commitlint/load": "^19.6.1",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "turbo": "2.3.3"
  }
}
