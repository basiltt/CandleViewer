# EditorConfig — CandleViewer (E02-T07). See docs/plan/01-sdlc-and-branching.md.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{js,jsx,ts,tsx,mjs,cjs,json,yaml,yml,md,mdx,css,scss,html}]
indent_size = 2
max_line_length = 100

[*.py]
indent_size = 4
max_line_length = 88

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
