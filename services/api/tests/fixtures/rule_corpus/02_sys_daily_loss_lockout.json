{
  "rule_id": "00000000-0000-4000-8000-0000000c0002",
  "version": 1,
  "name": "sys.daily_loss_lockout",
  "description": "Realised PnL today at or below the daily loss limit halts new orders until the next UTC day.",
  "enabled": true,
  "mode": "simulate",
  "scope": {
    "level": "account"
  },
  "trigger": {
    "type": "on_order_fill"
  },
  "conditions": {
    "node_id": "c1",
    "op": "lte",
    "left": {
      "metric": "realised_pnl_today"
    },
    "right": {
      "const": -500
    }
  },
  "actions": [
    {
      "node_id": "a1",
      "type": "halt_new_orders",
      "params": {
        "scope": "account",
        "until": "next_utc_day"
      }
    },
    {
      "node_id": "a2",
      "type": "send_notification",
      "params": {
        "channel": "ui",
        "severity": "critical",
        "template": "Daily loss limit reached"
      }
    }
  ],
  "limits": {
    "once_per": "day",
    "cooldown_ms": 1000
  },
  "editor": "form"
}
