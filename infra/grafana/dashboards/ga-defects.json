{
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "cv-prometheus"
        },
        "enable": true,
        "expr": "changes(build_info{env=\"$env\"}[$__rate_interval]) > 0",
        "iconColor": "#0072B2",
        "name": "Deploys",
        "tagKeys": "version,commit",
        "titleFormat": "deploy"
      }
    ]
  },
  "editable": false,
  "panels": [
    {
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "content": "## GA readiness - defects (GA 2027-03-25) - env = **$env**",
        "mode": "markdown"
      },
      "title": "Environment",
      "type": "text"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "panels": [],
      "title": "Burn-down vs GA target (S23-S26, GA 2027-03-25)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "cv-prometheus"
      },
      "description": "Legend lists severity P0 (most severe) to P3. Dashed lines are the exit targets.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          },
          "noValue": "STALE: no push for over 2 h (or no data)",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0072B2",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "TARGET.*"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 3,
      "maxDataPoints": 500,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cv-prometheus"
          },
          "expr": "ga_defects_open and on() (time() - push_time_seconds{job=\"ga_defects\"} < 7200)",
          "legendFormat": "{{severity}} open",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cv-prometheus"
          },
          "expr": "vector(0)",
          "legendFormat": "TARGET P0/P1 = 0 by 2027-03-25",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cv-prometheus"
          },
          "expr": "vector(10)",
          "legendFormat": "TARGET P2 <= 10 by 2027-03-25",
          "refId": "C"
        }
      ],
      "title": "Open defects by severity (stacked P0 > P1 > P2 > P3) vs target",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "cv-prometheus"
      },
      "description": "Linear regression, trailing 3 weeks. A projection, not a commitment.",
      "fieldConfig": {
        "defaults": {
          "noValue": "STALE: no push for over 2 h (or no data)",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0072B2",
                "value": null
              }
            ]
          },
          "unit": "d"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "id": 4,
      "maxDataPoints": 500,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cv-prometheus"
          },
          "expr": "ga_defect_forecast_days_to_zero{method=\"linear\"} and on() (time() - push_time_seconds{job=\"ga_defects\"} < 7200)",
          "legendFormat": "linear 3-week fit",
          "refId": "A"
        }
      ],
      "title": "Zero-crossing, linear fit (days from now; no value = undefined)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "cv-prometheus"
      },
      "description": "Mean net burn rate, trailing 3 weeks. A projection, not a commitment.",
      "fieldConfig": {
        "defaults": {
          "noValue": "STALE: no push for over 2 h (or no data)",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0072B2",
