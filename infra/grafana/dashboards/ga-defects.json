          "legendFormat": "closed (7d)",
          "refId": "B"
        }
      ],
      "title": "Arrival vs closure, rolling 7 days (arrival above closure cannot converge)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "cv-prometheus"
      },
      "description": "Cumulative histogram; triage SLA windows per 03-testing-strategy 11.3.",
      "fieldConfig": {
        "defaults": {
          "noValue": "STALE: no push for over 2 h (or no data)",
