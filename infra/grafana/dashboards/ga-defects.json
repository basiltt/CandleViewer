      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "id": 5,
      "maxDataPoints": 500,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cv-prometheus"
          },
          "expr": "ga_defect_forecast_days_to_zero{method=\"trailing_3w\"} and on() (time() - push_time_seconds{job=\"ga_defects\"} < 7200)",
          "legendFormat": "trailing 3-week rate",
          "refId": "A"
        }
      ],
      "title": "Zero-crossing, 3-week trailing rate (days from now)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
