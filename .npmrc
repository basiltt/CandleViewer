engine-strict=true
ignore-scripts=true
frozen-lockfile=true
save-exact=true
strict-peer-dependencies=false
# ---------------------------------------------------------------------------
# Supply-chain hardening (C-12.3, E02-T01 Security notes).
# ignore-scripts=true blocks arbitrary postinstall code execution. If a
# dependency genuinely needs a postinstall/preinstall/install script, add an
# explicit, reviewed allowlist entry here (pnpm supports per-package
# `pnpm.onlyBuiltDependencies` in package.json) rather than flipping this
# flag off. No entries are allowlisted yet.
# ---------------------------------------------------------------------------
