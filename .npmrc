engine-strict=true
ignore-scripts=true
frozen-lockfile=true
save-exact=true
strict-peer-dependencies=false
# ---------------------------------------------------------------------------
# Supply-chain hardening (C-12.3, E02-T01 Security notes).
# ignore-scripts=true blocks arbitrary postinstall code execution. If a
# dependency genuinely needs a postinstall/preinstall/install script, add an
# explicit, reviewed allowlist entry here (pnpm supports per-package
# `pnpm.onlyBuiltDependencies` in package.json) rather than flipping this
# flag off. No entries are allowlisted yet.
# ---------------------------------------------------------------------------
#
# E02-T07 exception: the root package's own `prepare` script (`husky`) installs
# the git hooks under .husky/. `ignore-scripts=true` also suppresses the root
# project's own lifecycle scripts under pnpm, so `pnpm install` will not run
# `prepare` automatically — this is intentional (reviewed in E02-X01): the
# hook installer is a single, code-owned, checked-in script (`husky`, which
# only writes a `core.hooksPath` pointer and copies the committed `.husky/*`
# files — no network fetch, no arbitrary code execution), so contributors and
# CI run it explicitly and deliberately instead of it firing implicitly on
# every install:
#   pnpm run prepare
# This is documented in CONTRIBUTING.md's setup steps. No other package may
# rely on `prepare`/`postinstall` without the same review + allowlist entry.
