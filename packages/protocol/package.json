{
  "name": "@candleviewer/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Generated TS types/decoders from OpenAPI (docs/plan/22-api-openapi.yaml) + WS schema (docs/plan/23-ws-protocol.md), plus runtime binary frame decoders and seq/resync helpers.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "build": "tsup",
    "size": "echo \"@candleviewer/protocol: no bundle budget\"",
    "generate": "node ./scripts/extract-ws-schema.mjs && node ./scripts/generate-rest-types.mjs && node ./scripts/generate-ws-types.mjs && node ./scripts/update-manifest.mjs && node ./scripts/check-generated-guard.mjs",
    "generate:check": "node ./scripts/extract-ws-schema.mjs --check && node ./scripts/check-generated-guard.mjs"
  },
  "devDependencies": {
    "@candleviewer/config": "workspace:*",
    "@types/node": "^22.10.2",
    "json-schema-to-typescript": "^16.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "globals": "^15.14.0",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0"
  }
}
