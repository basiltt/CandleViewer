{
  "name": "@candleviewer/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared ESLint flat config, Prettier config, base tsconfigs and Vitest preset for the CandleViewer monorepo.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./eslint": "./eslint.config.mjs",
    "./prettier": "./prettier.config.mjs",
    "./tsconfig/base.json": "./tsconfig.base.json",
    "./tsconfig/node.json": "./tsconfig.node.json",
    "./tsconfig/dom.json": "./tsconfig.dom.json",
    "./vitest": "./vitest.preset.mjs",
    "./no-restricted-imports": "./no-restricted-imports.mjs"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "echo \"@candleviewer/config: no TS sources to typecheck\"",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "build": "echo \"@candleviewer/config: nothing to build\"",
    "size": "echo \"@candleviewer/config: no bundle\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@commitlint/lint": "^21.2.3",
    "@commitlint/load": "^21.2.3"
  }
}
