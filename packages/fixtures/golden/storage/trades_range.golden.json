{
  "$schema": "https://candleviewer.internal/schemas/storage-golden.json",
  "case": "trades_range",
  "description": "Canonical, hand-verifiable case: 5 trades on BTCUSDT within [1000, 6000). Row order and values below were computed by hand, not derived from the repository under test.",
  "query": {
    "symbol": "BTCUSDT",
    "range": { "start_us": 1000, "end_us": 6000 }
  },
  "input_rows": [
    { "ts_us": 5000, "symbol": "BTCUSDT", "price": "50003", "qty": "0.4", "side": "sell", "trade_id": "t5" },
    { "ts_us": 1000, "symbol": "BTCUSDT", "price": "50000", "qty": "0.1", "side": "buy", "trade_id": "t1" },
    { "ts_us": 3000, "symbol": "BTCUSDT", "price": "50001", "qty": "0.2", "side": "buy", "trade_id": "t2" },
    { "ts_us": 3000, "symbol": "BTCUSDT", "price": "50002", "qty": "0.3", "side": "sell", "trade_id": "t3" },
    { "ts_us": 4000, "symbol": "ETHUSDT", "price": "2500", "qty": "1.0", "side": "buy", "trade_id": "t4" }
  ],
  "expected_rows": [
    { "ts_us": 1000, "symbol": "BTCUSDT", "price": "50000", "qty": "0.1", "side": "buy", "trade_id": "t1" },
    { "ts_us": 3000, "symbol": "BTCUSDT", "price": "50001", "qty": "0.2", "side": "buy", "trade_id": "t2" },
    { "ts_us": 3000, "symbol": "BTCUSDT", "price": "50002", "qty": "0.3", "side": "sell", "trade_id": "t3" },
    { "ts_us": 5000, "symbol": "BTCUSDT", "price": "50003", "qty": "0.4", "side": "sell", "trade_id": "t5" }
  ],
  "notes": "t4 (ETHUSDT) is excluded by symbol scoping. Rows at ts_us=3000 keep insertion tie-break order (t2 before t3) because both natural keys differ. Values are exact-string comparisons (no float tolerance) per docs/qa/plans/E07-storage.md section 1 (write-read fidelity)."
}
