{
  "name": "@candleviewer/fixtures",
  "version": "0.1.0",
  "private": true,
  "description": "Recorded, redacted Bybit fixtures + golden outputs, shared by TS and Python test suites. Never live-exchange data (C-13.5).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "echo \"@candleviewer/fixtures: no TS sources to typecheck\"",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "build": "echo \"@candleviewer/fixtures: nothing to build\"",
    "size": "echo \"@candleviewer/fixtures: no bundle\"",
    "verify": "node ./scripts/verify.mjs"
  },
  "devDependencies": {
    "@candleviewer/config": "workspace:*",
    "globals": "^17.13.0",
    "vitest": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0"
  }
}
