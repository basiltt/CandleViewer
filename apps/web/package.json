{
  "name": "@candleviewer/web",
  "version": "0.1.0",
  "private": true,
  "description": "CandleViewer React SPA (Vite): routes, feature slices, ws client, state. E02-T04 ships only the bootable skeleton; the real route tree, RBAC guards and env badge are E10.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "build": "vite build",
    "size": "size-limit",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@candleviewer/chart-engine": "workspace:*",
    "@candleviewer/config": "workspace:*",
    "@candleviewer/protocol": "workspace:*",
    "@candleviewer/ui": "workspace:*",
    "@playwright/test": "^1.49.1",
    "@size-limit/file": "^11.1.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "jsdom": "^30.1.1",
    "size-limit": "^11.1.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "size-limit": [
    {
      "name": "dist/assets/*.js",
      "path": "dist/assets/*.js",
      "limit": "8 MB",
      "gzip": true
    }
  ]
}
