{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(alembic:*)",
      "Bash(black:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh label create:*)",
      "Bash(gh label list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr view:*)",
      "Bash(gh project item-list:*)",
      "Bash(gh project view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git merge-base:*)",
      "Bash(git pull --rebase:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(git worktree:*)",
      "Bash(gitleaks:*)",
      "Bash(lint-imports:*)",
      "Bash(mypy:*)",
      "Bash(npx playwright:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm e2e:*)",
      "Bash(pnpm exec playwright:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm generate:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm size:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm verify:*)",
      "Bash(pytest:*)",
      "Bash(python .claude/hooks/*)",
      "Bash(python docs/design/_tools/*)",
      "Bash(python docs/plan/backlog/_tools/*)",
      "Bash(python docs/plan/backlog/_tools/validate.py:*)",
      "Bash(rm -rf /tmp/*)",
      "Bash(rm -rf tmp/*)",
      "Bash(ruff:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)"
    ],
    "ask": [
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue create:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(git push:*)",
      "Bash(docker compose:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin +main:*)",
      "Bash(git reset --hard origin/main:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf .:*)",
      "Bash(rm -rf ..:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh issue delete:*)",
      "Bash(curl *bybit.com*)",
      "Bash(curl *bytick.com*)",
      "Bash(wget *bybit.com*)",
      "Bash(wget *bytick.com*)",
      "WebFetch(domain:bybit.com)",
      "WebFetch(domain:api.bybit.com)",
      "WebFetch(domain:api-demo.bybit.com)",
      "WebFetch(domain:api-testnet.bybit.com)",
      "WebFetch(domain:stream.bybit.com)",
      "WebFetch(domain:bytick.com)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_edit_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_lint_reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}